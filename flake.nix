{
  description = "Wallpaper Engine backgrounds for Linux";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";

    # The git submodules in src/External, pinned to the same revisions as the checkout.
    # `self.submodules = true` is not used as it would also fetch quickjs' nested test262 submodule.
    # BEGIN SUBMODULES (generated by tools/dev/update-flake-submodules.py, do not edit)
    submodule-Catch2 = {
      url = "github:catchorg/Catch2/b3fb4b9feafcd8d91c5cb510a4775143fdbef02f";
      flake = false;
    };
    submodule-MimeTypes = {
      url = "github:lasselukkari/MimeTypes/8990d6a796bd9904ec3d41e5c150a1ffb48fe32e";
      flake = false;
    };
    submodule-SPIRV-Cross-WallpaperEngine = {
      url = "github:Almamu/SPIRV-Cross-WallpaperEngine/ad4d02220b01c1800e5a4e6671d6d8ca8ab07783";
      flake = false;
    };
    submodule-argparse = {
      url = "github:p-ranav/argparse/d924b84eba1f0f0adf38b20b7b4829f6f65b6570";
      flake = false;
    };
    submodule-glslang-WallpaperEngine = {
      url = "github:Almamu/glslang-WallpaperEngine/b775500a153f5ceb0e4b6f366b79c4c57521bb62";
      flake = false;
    };
    submodule-json = {
      url = "github:nlohmann/json/4424a0fcc1c7fa640b5c87d26776d99150dacd10";
      flake = false;
    };
    submodule-kissfft = {
      url = "github:mborgerding/kissfft/febd4caeed32e33ad8b2e0bb5ea77542c40f18ec";
      flake = false;
    };
    submodule-quickjs = {
      url = "github:quickjs-ng/quickjs/72ba50f63ee31202f8c18b8d07ab1e1c3486ee6f";
      flake = false;
    };
    submodule-stb = {
      url = "github:nothings/stb/f0569113c93ad095470c54bf34a17b36646bbbb5";
      flake = false;
    };
    # END SUBMODULES
  };

  outputs = inputs @ {
    self,
    nixpkgs,
    ...
  }: let
    systems = ["x86_64-linux" "aarch64-linux"];
    submodules = nixpkgs.lib.filterAttrs (name: _: nixpkgs.lib.hasPrefix "submodule-" name) inputs;
    forAllSystems = f: nixpkgs.lib.genAttrs systems (system: f nixpkgs.legacyPackages.${system});

    # Reuses nixpkgs' derivation (dependencies, pinned CEF, install fixups) and swaps in this checkout as source
    mkPackage = pkgs:
      pkgs.linux-wallpaperengine.overrideAttrs (old: {
        version = "0.0.1-unstable-${builtins.substring 0 8 (self.lastModifiedDate or "19700101")}-${self.shortRev or "dirty"}";
        src = self;
        # place the pinned submodules where CMake expects them
        postUnpack =
          (old.postUnpack or "")
          + nixpkgs.lib.concatStrings (nixpkgs.lib.mapAttrsToList (name: input: ''
              rm -rf "$sourceRoot/src/External/${nixpkgs.lib.removePrefix "submodule-" name}"
              cp -r --no-preserve=mode ${input} "$sourceRoot/src/External/${nixpkgs.lib.removePrefix "submodule-" name}"
            '')
            submodules);
        meta =
          old.meta
          // {
            homepage = "https://github.com/enocla/linux-wallpaperengine";
          };
      });
  in {
    packages = forAllSystems (pkgs: rec {
      linux-wallpaperengine = mkPackage pkgs;
      default = linux-wallpaperengine;
    });

    overlays.default = final: prev: {
      linux-wallpaperengine = mkPackage prev;
    };

    devShells = forAllSystems (pkgs: let
      base = pkgs.linux-wallpaperengine;
      # libraries the CEF distribution downloaded by CMake (build/cef) links against
      cefDeps = with pkgs; [
        alsa-lib
        at-spi2-atk
        at-spi2-core
        atk
        cairo
        cups
        dbus
        expat
        fontconfig
        freetype
        glib
        gtk3
        libdrm
        libgbm
        libx11
        libxcb
        libxcomposite
        libxdamage
        libxext
        libxfixes
        libxkbcommon
        libxrandr
        libxshmfence
        mesa
        nspr
        nss
        pango
        systemd
      ];
    in {
      default = pkgs.mkShell {
        inputsFrom = [base];
        packages = with pkgs; [
          clang-tools
          gdb
          imagemagick
          jq
          mpv
          mpvScripts.mpris
        ];
        # mpv-mpris plugin used by tools/dev/fake-mpris-player.sh
        MPV_MPRIS_PLUGIN = "${pkgs.mpvScripts.mpris}/share/mpv/scripts/mpris.so";
        shellHook = ''
          export LD_LIBRARY_PATH=${pkgs.lib.makeLibraryPath (base.buildInputs ++ cefDeps ++ [pkgs.libGL pkgs.vulkan-loader])}''${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
        '';
      };
    });

    formatter = forAllSystems (pkgs: pkgs.alejandra);
  };
}
